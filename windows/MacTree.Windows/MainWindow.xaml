<Window x:Class="MacTree.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MacTree.Windows"
 Title="MacTree for Windows — Preview" Width="1200" Height="800" MinWidth="850" MinHeight="600" Background="#F3F5F8" Icon="AppIcon.png">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,12"><Image Source="AppIcon.png" Width="44" Height="44" Margin="0,0,12,0"/><StackPanel><TextBlock Text="MacTree" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Storage explorer · Windows preview" Foreground="#64748B"/></StackPanel></DockPanel>
   <DockPanel><Button x:Name="Choose" Content="Choose folder" Click="ChooseFolder" DockPanel.Dock="Right"/><Button x:Name="Scan" Content="Scan" Click="StartScan" DockPanel.Dock="Right"/><Button x:Name="Stop" Content="Stop" Click="StopScan" IsEnabled="False" DockPanel.Dock="Right"/><TextBox x:Name="Location" VerticalContentAlignment="Center" Margin="0,4,8,4" Padding="8"/></DockPanel>
   <TextBlock x:Name="Summary" Text="Choose a folder or enter a drive such as C:\" Margin="4,12" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <ProgressBar x:Name="Busy" Height="3" Visibility="Collapsed" IsIndeterminate="True"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="4,12,4,0" Text="Ready · Standard folder scan" TextTrimming="CharacterEllipsis"/>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <TreeView x:Name="Tree" SelectedItemChanged="TreeSelected" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
     <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:Entry}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" Margin="3"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
    <DockPanel Grid.Column="2">
     <DockPanel DockPanel.Dock="Top"><Button Content="↑ Up" Click="GoUp"/><TextBlock x:Name="CurrentPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" MouseDoubleClick="OpenSelected" HeadersVisibility="Column">
      <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="110"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="80"/></DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Grid>
   <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
   <DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Top" Text="DISK MAP · Double-click a folder to explore" Foreground="#64748B" Margin="4,8"/><local:Treemap x:Name="Map"/></DockPanel>
  </Grid>
 </DockPanel>
</Window>
