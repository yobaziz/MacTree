<Window x:Class="MacTree.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MacTree.Windows"
 Title="MacTree for Windows" Width="1360" Height="900" MinWidth="1000" MinHeight="700" Background="#F3F6FA" Foreground="#1E293B" FontFamily="Segoe UI" FontSize="13" Icon="AppIcon.png" UseLayoutRounding="True">
 <DockPanel Margin="22,18">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,18"><Image Source="AppIcon.png" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="MacTree" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="WINDOWS PREVIEW" FontSize="10" Foreground="#64748B" Margin="14,0,0,0" VerticalAlignment="Center"/></DockPanel>
   <DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="Choose" Content="Choose folder" Click="ChooseFolder"/><Button x:Name="Scan" Content="Scan drive" Click="StartScan" Background="#2563EB" Foreground="White"/><Button x:Name="Stop" Content="Stop" Click="StopScan" IsEnabled="False"/></StackPanel><TextBox x:Name="Location" VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="12,8" BorderBrush="#CBD5E1" Background="White"/></DockPanel>
   <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="VolumeTitle" Text="DRIVE CAPACITY" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="TotalSpace" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="USED SPACE" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="UsedSpace" Text="—" FontSize="20" Foreground="#2563EB" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="FREE SPACE" Foreground="#64748B" FontSize="11"/><TextBlock x:Name="FreeSpace" Text="—" FontSize="20" Foreground="#059669" FontWeight="SemiBold"/></StackPanel>
    </Grid>
    <Grid Margin="0,10,0,0" Height="9" x:Name="CapacityBar"><Grid.ColumnDefinitions><ColumnDefinition x:Name="UsedColumn" Width="0*"/><ColumnDefinition x:Name="FreeColumn" Width="1*"/></Grid.ColumnDefinitions><Border Background="#2563EB"/><Border Grid.Column="1" Background="#34D399"/></Grid>
    <TextBlock Text="Drive usage from Windows · Scanned file sizes are shown separately below" Foreground="#64748B" FontSize="11" Margin="0,7,0,0"/>
   </StackPanel>
   <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,14"><TextBlock x:Name="Summary" Text="Choose a folder or enter a drive to explore your storage." FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
   <ProgressBar x:Name="Busy" Height="3" Visibility="Collapsed" IsIndeterminate="True"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="2,12,2,0" Foreground="#64748B" Text="Ready · Standard folder scan" TextTrimming="CharacterEllipsis"/>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="1*" MinHeight="170"/><RowDefinition Height="10"/><RowDefinition Height="1*" MinHeight="220"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="440"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8"><DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="FOLDERS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="8,6,0,10"/>
     <TreeView x:Name="Tree" BorderThickness="0" SelectedItemChanged="TreeSelected" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/><Setter Property="Padding" Value="5,5"/><EventSetter Event="Selected" Handler="TreeItemSelected"/></Style></TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:Entry}" ItemsSource="{Binding Folders}"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="#38A6D8" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Size}" Foreground="#64748B" Margin="12,0,0,0"/><TextBlock Text="{Binding Coverage}" Foreground="#B45309" Margin="6,0,0,0"/></StackPanel></HierarchicalDataTemplate></TreeView.ItemTemplate>
     </TreeView>
    </DockPanel></Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"><DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="8"><Button Content="↑ Up" Click="GoUp"/><TextBlock x:Name="CurrentPath" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
     <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" MouseDoubleClick="OpenSelected" SelectionChanged="FileSelected" HeadersVisibility="Column" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="None" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="115"/><DataGridTextColumn Header="% folder" Binding="{Binding Share}" SortMemberPath="Bytes" Width="90"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="90"/></DataGrid.Columns>
     </DataGrid>
    </DockPanel></Border>
   </Grid>
   <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>
   <Border Grid.Row="2" Background="#111D30" CornerRadius="8" Padding="12"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10"><TextBlock Text="FOLDER BREAKDOWN" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Click to select · Double-click a folder to open" Foreground="#94A3B8" HorizontalAlignment="Right"/></DockPanel>
    <TextBlock x:Name="MapDetail" DockPanel.Dock="Bottom" Text="Names stay visible. Bar length shows the share of this folder." Foreground="#94A3B8" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
    <local:Treemap x:Name="Map"/>
   </DockPanel></Border>
  </Grid>
 </DockPanel>
</Window>
